{
  "id": "lrclib",
  "name": "LRCLIB",
  "version": "1.0.0",
  "author": "meofishes",
  "description": "Line-synced lyrics from lrclib.net, as a fallback for Meo Lyrics. Example declarative fnt (lyrics) plugin.",
  "homepage": "https://lrclib.net",
  "types": ["fnt"],
  "runtime": "declarative",
  "hosts": [
    "lrclib.net"
  ],
  "lyrics": {
    "request": {
      "url": "https://lrclib.net/api/search?track_name={{cleanTitle}}&artist_name={{primaryArtist}}"
    },
    "path": "[0].syncedLyrics || [0].plainLyrics",
    "format": "auto",
    "credit": "Letras do LRCLIB"
  }
}