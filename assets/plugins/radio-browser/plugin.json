{
  "id": "radio-browser",
  "name": "Radio Browser",
  "version": "1.1.0",
  "author": "meofishes",
  "description": "Thousands of online radios from radio-browser.info. 100% declarative: only endpoints and field mapping, no code.",
  "homepage": "https://www.radio-browser.info",
  "types": ["fnt", "src"],
  "runtime": "declarative",
  "hosts": ["*.api.radio-browser.info", "all.api.radio-browser.info"],
  "settings": [
    { "key": "server", "label": "Server", "default": "https://de1.api.radio-browser.info",
      "description": "Any mirror listed at all.api.radio-browser.info" },
    { "key": "limit", "label": "Results per search", "type": "number", "default": "60" },
    { "key": "country", "label": "Country code for the home page", "default": "BR" }
  ],
  "source": {
    "baseUrl": "{{settings.server}}",
    "search": {
      "url": "/json/stations/search?name={{query}}&limit={{settings.limit}}&hidebroken=true&order=clickcount&reverse=true",
      "items": "$",
      "map": {
        "id": "stationuuid",
        "title": "name",
        "artist": "country || countrycode",
        "album": "tags",
        "cover": "favicon",
        "streamUrl": "url_resolved || url",
        "codec": "codec",
        "bitrate": "bitrate"
      }
    },
    "home": {
      "url": "/json/stations/search?countrycode={{settings.country}}&limit=40&hidebroken=true&order=clickcount&reverse=true",
      "items": "$",
      "map": {
        "id": "stationuuid", "title": "name", "artist": "country", "album": "tags",
        "cover": "favicon", "streamUrl": "url_resolved || url"
      }
    },
    "resolver": "direct"
  }
}
