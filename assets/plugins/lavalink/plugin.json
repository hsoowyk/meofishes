{
  "id": "lavalink",
  "name": "Lavalink",
  "version": "1.0.0",
  "author": "meofishes",
  "description": "Searches a Lavalink v4 server (YouTube, SoundCloud, Bandcamp, Spotify/Deezer/Apple through LavaSrc…). Lavalink resolves the tracks; the audio plays through mpv.",
  "types": ["fnt", "src"],
  "runtime": "script",
  "entry": "main.js",
  "modules": ["lavalink", "ytdlp"],
  "settings": [
    { "key": "host", "label": "Host", "default": "localhost" },
    { "key": "port", "label": "Port", "default": "2333" },
    { "key": "password", "label": "Password", "type": "password", "default": "youshallnotpass" },
    { "key": "secure", "label": "HTTPS", "type": "bool", "default": "false" },
    { "key": "prefix", "label": "Search prefix", "type": "choice",
      "choices": ["ytmsearch", "ytsearch", "scsearch", "spsearch", "dzsearch", "amsearch"], "default": "ytmsearch" }
  ]
}
