{
  "id": "layout-cinema",
  "name": "Layout: Cinema",
  "version": "1.0.0",
  "author": "meofishes",
  "description": "Barra do player no topo, páginas ocupando a tela toda e o 'tocando agora' embaixo.",
  "types": ["layout"],
  "layout": {
    "box": "v", "spacing": 0,
    "children": [
      { "region": "playerbar" },
      { "split": "h", "stretch": 1, "sizes": [220, 1000], "children": [
        { "region": "sidebar", "minWidth": 190, "maxWidth": 300 },
        { "split": "v", "stretch": 1, "sizes": [600, 300], "children": [
          { "region": "pages", "stretch": 1 },
          { "region": "lyrics", "minHeight": 160 }
        ]}
      ]}
    ]
  }
}
